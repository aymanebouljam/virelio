generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

// Models
model Vendor {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  email      String?
  phone      String?
  website    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  expenses                  Expense[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String                     @db.Uuid

  @@unique([userId, name])
  @@unique([userId, email])
  @@unique([userId, phone])
  @@unique([userId, website])
}

model ExpenseCategory {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  color      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  expenses                  Expense[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String                     @db.Uuid

  @@unique([userId, name])
}

model Expense {
  id                         String    @id @default(uuid()) @db.Uuid
  vendorId                   String    @db.Uuid
  categoryId                 String?   @db.Uuid
  description                String
  amount                     Decimal   @db.Decimal(12, 2)
  currency                   String    @default("USD")
  expenseDate                DateTime
  notes                      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  archivedAt                 DateTime?
  recurringExpenseTemplateId String?   @db.Uuid

  proofs ProofDocument[]

  vendor                   Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category                 ExpenseCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpenseTemplate RecurringExpenseTemplate? @relation(fields: [recurringExpenseTemplateId], references: [id], onDelete: SetNull)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String                    @db.Uuid

  @@unique([recurringExpenseTemplateId, expenseDate])
}

model RecurringExpenseTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  vendorId    String              @db.Uuid
  categoryId  String?             @db.Uuid
  description String
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("USD")
  frequency   RecurrenceFrequency
  nextDueDate DateTime
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  archivedAt  DateTime?

  generatedExpenses Expense[]
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String           @db.Uuid

  @@index([userId, archivedAt, nextDueDate])
}

model ProofDocument {
  id           String   @id @default(uuid()) @db.Uuid
  expenseId    String   @db.Uuid
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendors                   Vendor[]
  expenses                  Expense[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  ExpenseCategories         ExpenseCategory[]
}
