{
  "name": "virelio",
  "version": "1.1.0",
  "description": "Multi-tenant expense tracking, proof management, reporting, and recurring expenses",
  "author": "Aymane Bouljam",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "pnpm --parallel --filter backend --filter frontend run dev",
    "env:setup": "pnpm --filter backend env:setup && pnpm --filter frontend env:setup",
    "build": "pnpm -r build",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "typecheck": "pnpm -r typecheck",
    "qa": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "prisma:format": "pnpm --filter backend prisma:format",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:validate": "pnpm --filter backend prisma:validate",
    "prisma:migrate:dev": "pnpm --filter backend prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter backend prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter backend prisma:migrate:reset",
    "prisma:migrate:test": "pnpm --filter backend prisma:migrate:test",
    "seed": "pnpm --filter backend seed",
    "database:setup": "pnpm --filter backend database:setup",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12"
  },
  "lint-staged": {
    "frontend/**/*.{ts,js,css,json,md,vue}": [
      "pnpm --filter frontend exec oxfmt"
    ],
    "frontend/**/*.{ts,js}": [
      "pnpm --filter frontend exec oxlint --fix"
    ],
    "frontend/**/*.vue": [
      "pnpm --filter frontend exec eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "pnpm --filter backend exec prettier --write",
      "pnpm --filter backend exec eslint --fix"
    ],
    "backend/**/*.{json,md}": [
      "pnpm --filter backend exec prettier --write"
    ]
  }
}
